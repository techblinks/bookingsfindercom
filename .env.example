# ── BookingsFinder V2 ── Environment Variables ──

# === FRONTEND-SAFE (exposed to browser, use VITE_ prefix) ===

# Supabase project URL (required)
VITE_SUPABASE_URL=

# Supabase anonymous/public key (required)
# NOT the service_role key — that must never appear in frontend code
VITE_SUPABASE_PUBLISHABLE_KEY=

# Supabase project reference (optional — used in admin tools)
VITE_SUPABASE_PROJECT_ID=


# Travelpayouts White Label hostname (e.g. flights.bookingsfinder.com)
# Required for White Label flight search results to use the branded subdomain
VITE_TRAVEL_WHITE_LABEL_HOST=

# White Label rollout mode: disabled (default), test, or enabled
# Production must be set to "enabled" to activate White Label URLs
VITE_TRAVEL_WHITE_LABEL_MODE=disabled

# === NOTES ===
#
# 1. Never commit your real .env file. It is ignored by .gitignore.
# 2. Copy this file to .env and fill in your values:
#    cp .env.example .env
# 3. For production deployment, set these same variables in your
#    hosting platform (Vercel, Netlify, etc.).
# Edge Function (server-side only) — set in Supabase Dashboard → Edge Functions → get-redirect → Env vars:
#   WHITE_LABEL_HOST=flights.bookingsfinder.com
# 4. VITE_SUPABASE_PUBLISHABLE_KEY is the anon key, not the service_role
#    key. The service_role key must only be used in Edge Functions or
#    server-side code, never in the browser.
# 5. If Supabase is unavailable, public pages (homepage, flights,
#    trip-cost) still work. Features requiring Supabase (auth, admin,
#    price alerts, subscribers, blog CMS, optimizer) will fail
#    gracefully with user-visible errors.
